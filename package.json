{
  "name": "prompting",
  "private": true,
  "version": "v.8.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "homepage": "https://prompting-chat.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbaz/web-chat.git"
  },
  "author": "Julio Corbaz <julio.corbaz@gmail.com>",
  "bugs": {
    "url": "https://github.com/corbaz/web-chat/issues"
  },
  "license": "MIT",
  "keywords": [
    "web chat",
    "AI",
    "Groq"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "bun-install": "bun install",
    "bun-upgrade": "bun upgrade && bunx -y npm-check-updates",
    "ncu": "bunx -y npm-check-updates -u && bun update --minimum-release-age 0",
    "dev": "vite --host",
    "typecheck": "tsc -b",
    "lint": "biome lint --write src",
    "format:check": "biome format src",
    "format:write": "biome format --write src",
    "check": "biome check --write src",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "deploy": "vercel deploy --prod",
    "update:vision": "bun scripts/update-vision-models.ts",
    "update:models": "bun scripts/update-vision-models.ts",
    "opencode:free": "bun scripts/opencode-free/start.ts",
    "opencode:free:install": "bun scripts/opencode-free/install.ts",
    "opencode:free:uninstall": "bun scripts/opencode-free/uninstall.ts",
    "opencode:free:password": "bun scripts/opencode-free/password.ts",
    "claude:bridge": "bun scripts/claude-bridge/server.ts",
    "build:bridge": "bun build scripts/claude-bridge/server.ts --target bun --outfile scripts/claude-bridge/claude-bridge.js",
    "codex:bridge": "bun scripts/codex-bridge/server.ts",
    "build:codex-bridge": "bun build scripts/codex-bridge/server.ts --target bun --outfile scripts/codex-bridge/codex-bridge.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "axios": "1.20.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-select": "5.10.2",
    "remark-gfm": "4.0.1",
    "sweetalert2": "11.26.25",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
