{
  "name": "prompting",
  "private": true,
  "version": "v.7.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "homepage": "https://prompting-chat.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbaz/web-chat.git"
  },
  "author": "Julio Corbaz <julio.corbaz@gmail.com>",
  "bugs": {
    "url": "https://github.com/corbaz/web-chat/issues"
  },
  "license": "MIT",
  "keywords": [
    "web chat",
    "AI",
    "Groq"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "bun-install": "bun install",
    "bun-upgrade": "bun upgrade && bunx -y npm-check-updates",
    "ncu": "bunx -y npm-check-updates -u && bun update --minimum-release-age 0",
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write src",
    "format:check": "biome format src",
    "format:write": "biome format --write src",
    "check": "biome check --write src",
    "build": "tsc -b && vite build --outDir ./docs",
    "preview": "vite preview --host",
    "deploy": "surge docs --domain deepchat.surge.sh",
    "deploy:vercel": "vercel deploy --prod",
    "update:vision": "bun scripts/update-vision-models.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "axios": "1.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-select": "5.10.2",
    "remark-gfm": "4.0.1",
    "sweetalert2": "11.26.25",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
